{
  "name": "decision-workshop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check:packs": "tsx scripts/lint-packs.ts",
    "check:engine": "vitest run tests --passWithNoTests",
    "check": "npm run typecheck && npm run check:packs && npm run check:engine",
    "check:links": "tsx scripts/check-links.ts",
    "screenshots": "SCREENSHOTS=1 playwright test screenshots"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
