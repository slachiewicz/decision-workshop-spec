{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pack.schema.json",
  "title": "Pack manifest",
  "type": "object",
  "required": ["id", "name", "platform_label", "release", "groups", "canvas"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z]+$" },
    "name": { "type": "string" },
    "platform_label": { "type": "string" },
    "release": { "type": "string", "pattern": "^\\d{4}\\.\\d{1,2}\\.\\d{1,2}$" },
    "groups": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["part", "title", "blurb", "topics"],
        "additionalProperties": false,
        "properties": {
          "part": { "type": "integer" },
          "title": { "type": "string" },
          "blurb": { "type": "string", "maxLength": 300 },
          "topics": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    },
    "canvas": {
      "type": "object",
      "required": ["container_label", "landing_label", "layer_engine_labels", "serving_label", "badge_labels"],
      "additionalProperties": false,
      "properties": {
        "container_label": { "type": "string" },
        "landing_label": { "type": "string" },
        "layer_engine_labels": { "type": "object", "additionalProperties": { "type": "string" } },
        "serving_label": { "type": "string" },
        "badge_labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
